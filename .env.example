# IndustrialGuard AI — Environment Variables Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── IBM watsonx.ai ─────────────────────────────────────────────────────────────
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=your_ibm_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default for MVP — no setup required)
DATABASE_URL=sqlite:///./industrialguard.db
# PostgreSQL (upgrade when ready):
# DATABASE_URL=postgresql://user:password@localhost:5432/industrialguard

# ── Backend ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Dataset ───────────────────────────────────────────────────────────────────
# Set after Gate B dataset selection
DATASET_FILENAME=dataset.csv
TARGET_COLUMN=target

# ── Demo / Fallback ───────────────────────────────────────────────────────────
# Set to "true" to use pre-cached Granite responses when IBM API is unavailable
USE_CACHED_GRANITE_RESPONSES=true
